# PostgreSQL connection string.
# Local dev: a local Postgres, e.g.
#   DATABASE_URL="postgresql://postgres@127.0.0.1:5432/sideline"
# Production (Netlify): paste your Neon/Supabase connection string.
# Tip: use Neon's "connection string" (include ?sslmode=require).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Secret used to sign auth (JWT) cookies. Use a long random string in production.
AUTH_SECRET="change-me-to-a-long-random-string"
