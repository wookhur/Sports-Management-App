# Postgres connection string. Use any managed Postgres (Neon, Supabase,
# Railway, …). Netlify runs on serverless Lambda with a read-only filesystem,
# so file-based SQLite cannot be used — a hosted Postgres is required.
# Example (Neon): postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/db?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/sideline365"

# Secret used to sign auth (JWT) cookies. Use a long random string in production.
AUTH_SECRET="change-me-to-a-long-random-string"
