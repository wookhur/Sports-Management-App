// Sports Management App — data model
// PostgreSQL (local dev and production). Set DATABASE_URL to your Postgres URL.

generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; the rhel target is what Netlify/AWS Lambda
  // functions run on, so the query engine is bundled for production too.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ATHLETE
  COACH
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      Role     @default(ATHLETE)
  onboarded Boolean  @default(false)
  createdAt DateTime @default(now())

  // Profile fields collected by the Roy onboarding wizard (all optional so
  // existing rows and API callers that omit them stay valid).
  username        String?   @unique
  school          String?
  sportInterests  String[]  @default([])
  experienceLevel String?
  dob             DateTime?
  grade           String?

  // Daily-activity streak ("연속 출석"). Counts any visit on a given day.
  lastActiveOn  DateTime?
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)

  // Comment-notification cursor: coach comments on my records created after
  // this moment count as "new" until I open my records page again.
  lastSeenCommentsAt DateTime?

  // Gamification ("미션 & 캐릭터"): 완두콩(beans) is the spendable currency
  // earned by completing daily missions; XP is cumulative and drives the
  // character/house level; houseRepairs holds the ids of finished repairs.
  beans        Int      @default(0)
  charXp       Int      @default(0)
  houseRepairs String[] @default([])

  // Home dashboard personalization: widget keys the user has chosen to hide.
  // Empty = show every default section.
  homeHidden String[] @default([])

  records          Record[]
  comments         Comment[]
  posts            BlogPost[]
  athleteGuides    AthleteGuide[]
  goals            Goal[]
  blogComments     BlogComment[]
  blogLikes        BlogLike[]
  missionClaims    MissionClaim[]
  boardPosts       BoardPost[]
  boardComments    BoardComment[]
  boardLikes       BoardLike[]
  trainingSessions TrainingSession[]

  assignmentsGiven    Assignment[] @relation("AssignmentCoach")
  assignmentsReceived Assignment[] @relation("AssignmentAthlete")
  teamsOwned          Team[]       @relation("TeamCoach")
  teamMemberships     TeamMember[]

  // A coach can be linked to many athletes and vice-versa.
  coachLinks   CoachAthlete[] @relation("CoachSide")
  athleteLinks CoachAthlete[] @relation("AthleteSide")
}

// A personal record target, e.g. "자유형 50m under 32s". Progress is derived
// from the athlete's best record for the metric; achievedAt is stamped the
// first time a record meets the target.
model Goal {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  sport      String
  metricKey  String
  metricName String
  targetMs   Int
  achievedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// Training homework a coach assigns to a linked athlete. linkHref points at
// an in-app resource (a workout, drill, program, or star routine page).
model Assignment {
  id          String    @id @default(cuid())
  coach       User      @relation("AssignmentCoach", fields: [coachId], references: [id], onDelete: Cascade)
  coachId     String
  athlete     User      @relation("AssignmentAthlete", fields: [athleteId], references: [id], onDelete: Cascade)
  athleteId   String
  title       String
  note        String?
  linkHref    String?
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([athleteId])
  @@index([coachId])
}

// A coach-owned squad. Athletes join with the invite code.
model Team {
  id        String       @id @default(cuid())
  name      String
  code      String       @unique
  coach     User         @relation("TeamCoach", fields: [coachId], references: [id], onDelete: Cascade)
  coachId   String
  members   TeamMember[]
  createdAt DateTime     @default(now())
}

model TeamMember {
  id        String   @id @default(cuid())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([teamId, userId])
  @@index([userId])
}

// Reader comments under a blog post (any logged-in user).
model BlogComment {
  id        String   @id @default(cuid())
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  body      String
  createdAt DateTime @default(now())

  @@index([postId])
}

model BlogLike {
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@id([postId, userId])
}

// Blog posts, authored in-app (currently by coaches) or seeded.
model BlogPost {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  excerpt   String
  body      String // markdown-ish plain text
  emoji     String   @default("📝")
  tag       String?
  coverImage String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId  String?
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  readerComments BlogComment[]
  likes          BlogLike[]

  @@index([published, createdAt])
}

// "유명 선수 훈련법" — a per-sport writeup of how a well-known athlete
// trains, authored in-app by coaches. Same shape/pipeline as BlogPost
// (rich-text HTML body, DB-stored cover image) but scoped to one sport.
model AthleteGuide {
  id          String   @id @default(cuid())
  sport       String // sport id from the registry, e.g. "swimming"
  slug        String   @unique
  athleteName String
  title       String
  excerpt     String
  body        String // sanitized rich-text HTML
  coverImage  String?
  author      User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId    String?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sport, published, createdAt])
}

// An uploaded image, stored directly in Postgres (no external object storage
// configured). Served back via GET /api/blog/images/[id]; BlogPost.coverImage
// just holds that URL string, so there's no direct FK relation.
model BlogImage {
  id        String   @id @default(cuid())
  data      Bytes
  mimeType  String
  createdAt DateTime @default(now())
}

// Explicit many-to-many link between a coach and an athlete.
model CoachAthlete {
  id        String   @id @default(cuid())
  coach     User     @relation("CoachSide", fields: [coachId], references: [id], onDelete: Cascade)
  coachId   String
  athlete   User     @relation("AthleteSide", fields: [athleteId], references: [id], onDelete: Cascade)
  athleteId String
  createdAt DateTime @default(now())

  @@unique([coachId, athleteId])
  @@index([coachId])
  @@index([athleteId])
}

// A single performance record. Sport-agnostic core with optional
// structured fields so new sports/metrics can be added without migrations.
model Record {
  id       String @id @default(cuid())
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String

  sport      String // sport id from the registry, e.g. "swimming"
  metricKey  String // metric id, e.g. "freestyle_50m"
  metricName String // human label snapshot, e.g. "자유형 50m"

  // Structured measurements (all optional; used per metric)
  distanceM  Float? // meters
  durationMs Int? //   milliseconds
  value      Float? // generic numeric value
  unit       String? // unit for `value`

  notes     String?
  shared    Boolean  @default(false)
  createdAt DateTime @default(now())

  comments Comment[]

  @@index([userId])
  @@index([sport])
}

// Coach feedback on a shared record.
model Comment {
  id       String   @id @default(cuid())
  record   Record   @relation(fields: [recordId], references: [id], onDelete: Cascade)
  recordId String
  author   User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String
  body     String
  createdAt DateTime @default(now())

  @@index([recordId])
}

// "훈련 일지" — one diary entry per training block. A day's entries (plus any
// timed Records logged that day) are scored into the daily training score,
// the sports-app analogue of a diet app's per-day meal score. `day` is a
// YYYY-MM-DD string in Asia/Seoul, same convention as MissionClaim.
model TrainingSession {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  day       String
  sport     String // sport id from the registry
  kind      String // technique | strength | cardio | match | recovery
  minutes   Int
  intensity Int // RPE 1–10
  notes     String?
  createdAt DateTime @default(now())

  @@index([userId, day])
}

// One row per (user, mission, day) recording that a daily mission was claimed.
// `day` is a YYYY-MM-DD string in Asia/Seoul so missions reset at local midnight.
model MissionClaim {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  missionKey String
  day        String
  createdAt  DateTime @default(now())

  @@unique([userId, missionKey, day])
  @@index([userId, day])
}

// "자유게시판" — a casual community feed. Any logged-in user can post text
// plus optional images (stored via the BlogImage upload pipeline). Views are
// bumped on the detail page.
model BoardPost {
  id        String   @id @default(cuid())
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  // Community section: "general" (일반), "tips" (팁), or "gameplay" (경기영상).
  // gameplay/tips posts are the "share your team's gameplay or tips" surface.
  category  String   @default("general")
  title     String?
  body      String
  images    String[] @default([])
  videoUrl  String? // optional gameplay clip link (YouTube/Vimeo/Hudl/…)
  views     Int      @default(0)
  createdAt DateTime @default(now())

  comments BoardComment[]
  likes    BoardLike[]

  @@index([createdAt])
}

model BoardComment {
  id        String    @id @default(cuid())
  post      BoardPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  body      String
  createdAt DateTime  @default(now())

  @@index([postId])
  @@index([authorId, createdAt])
}

model BoardLike {
  post      BoardPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime  @default(now())

  @@id([postId, userId])
}
